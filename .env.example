# Server configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Server-only OpenCode Zen key for free script models (never use a VITE_ variable).
OPENCODE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# OpenRouter is configured via the frontend settings page.
# The API key is stored in localStorage and sent to the
# server via the x-api-key header on each request.

# Local Chatterbox TTS (default provider)
TTS_PROVIDER=chatterbox
CHATTERBOX_URL=http://127.0.0.1:8880
CHATTERBOX_HOST=127.0.0.1
CHATTERBOX_PORT=8880
CHATTERBOX_DEVICE=auto
CHATTERBOX_T3_MODEL=v3
CHATTERBOX_TIMEOUT_MS=900000
CHATTERBOX_MAX_CHUNK_CHARS=280

# Optional overrides
# CHATTERBOX_PYTHON=C:\path\to\python.exe
# HF_TOKEN=hf_token_only_if_your_Hugging_Face_setup_requires_it

# AI presenter: reuses the existing MuseTalk-Demo installation and Conda environment.
# On this PC these paths are detected automatically; override when installed elsewhere.
# MUSETALK_ROOT=C:\Users\zrajc\OneDrive\Documents\MuseTalk-Demo
# MUSETALK_PYTHON=C:\Users\zrajc\miniconda3\envs\musetalk-demo\python.exe
