# Copy this file to server/.env for the normal npm run dev / dev:server startup.
# Complete installation and model downloads: docs/NEW_PC_SETUP.md
# Server configuration
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Server-only OpenCode Zen key for free script models (never use a VITE_ variable).
GEMINI_API_KEY=your_google_ai_studio_key_here
OPENCODE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Xkiro script generation and AI editing (server-only).
XKIRO_API_KEY=

# OpenRouter is configured via the frontend settings page.
# The API key is stored in localStorage and sent to the
# server via the x-api-key header on each request.

# Local Chatterbox TTS (default provider)
TTS_PROVIDER=chatterbox
CHATTERBOX_URL=http://127.0.0.1:8880
CHATTERBOX_HOST=127.0.0.1
CHATTERBOX_PORT=8880
CHATTERBOX_DEVICE=auto
CHATTERBOX_T3_MODEL=v3
CHATTERBOX_TIMEOUT_MS=900000
CHATTERBOX_MAX_CHUNK_CHARS=280

# Optional overrides
# CHATTERBOX_PYTHON=C:\path\to\python.exe
# HF_TOKEN=hf_token_only_if_your_Hugging_Face_setup_requires_it

# ComfyUI: install separately, then uncomment and replace both absolute paths.
# COMFYUI_PATH=C:/AI/TubeFlow/ComfyUI
# COMFYUI_PYTHON=C:/AI/TubeFlow/artifacts/comfy-venv/Scripts/python.exe
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Despite its filename, the bundled workflow currently uses an SDXL checkpoint.
# COMFYUI_WORKFLOW_PATH=C:/AI/TubeFlow/server/workflows/flux_klein_t2i.json
COMFYUI_PROMPT_NODE_ID=6
COMFYUI_SEED_NODE_ID=13
COMFYUI_SEED_INPUT_KEY=seed
COMFYUI_TIMEOUT_MS=600000
COMFYUI_LOW_VRAM=true

# AI presenter: requires the separate custom MuseTalk-Demo app, weights and avatars.
# A clone of upstream MuseTalk alone is insufficient. See docs/NEW_PC_SETUP.md.
# MUSETALK_ROOT=C:/AI/MuseTalk-Demo
# MUSETALK_PYTHON=C:/Users/YOUR_USERNAME/miniconda3/envs/musetalk-demo/python.exe

# Motion graphics (see docs/AI_VIDEO_EDITING_SETUP.md). Uses GEMINI_API_KEY above.
# Optional Gemini model override; the Artifacts picker can override per project.
EDITING_PLANNER_MODEL=
EDITING_MAX_PROVIDER_CALLS=40
EDITING_RENDER_CONCURRENCY=1
EDITING_PROVIDER_TIMEOUT_MS=120000
EDITING_RENDER_TIMEOUT_MS=1800000
# EDITING_BROWSER_EXECUTABLE=/path/to/chrome

# Cloudflare Workers AI image pool (optional env seed — the Image tab API pool is preferred).
# Single-key (legacy): CLOUDFLARE_WORKER_URL + CLOUDFLARE_WORKER_API_KEY, or
# CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN.
# Multi-key failover: comma-separated lists, one entry per Cloudflare account.
# Generation tries them in order and auto-switches on 429 / quota / 5xx.
# CLOUDFLARE_WORKER_URLS=https://api-one.yourname.workers.dev,https://api-two.yourname.workers.dev
# CLOUDFLARE_WORKER_API_KEYS=key-for-api-one,key-for-api-two
# CLOUDFLARE_ACCOUNT_IDS=account-id-one,account-id-two
# CLOUDFLARE_API_TOKENS=token-one,token-two

# Google Flow video automation (free tier: spends subscription credits, $0 new cash).
# Unofficial browser automation: uses your own Pro/Ultra login, never stores your
# password. One-time headed login reuses the profile dir below.
# FLOW_PROFILE_DIR=./server/data/flow/profile-default
# FLOW_HEADLESS=true
# FLOW_PROJECT_URL=https://labs.google/fx/tools/flow
# FLOW_CREDIT_BUDGET_PER_EPISODE=320
# FLOW_MAX_JOBS=1

# Facebook + Instagram publishing (Meta Graph API, one app covers both).
# Alternatively configure per-account from the app: Export → Facebook/Instagram → Setup Meta App.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# META_GRAPH_VERSION=v21.0
# FACEBOOK_REDIRECT_URI=http://localhost:3001/api/facebook/callback
# INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/instagram/callback

